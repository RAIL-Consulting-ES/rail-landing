---
---

<section class="hero" id="hero">
	<div class="hero__inner">
		<h1 class="hero__title" aria-label="RAIL">
			<span class="letter letter--r">R</span><span class="letter letter--a"
				>A</span
			><span class="letter letter--i">I</span><span class="letter letter--l"
				>L</span
			>
		</h1>
		<div class="hero__subtitle">
			<span class="sub sub--1">Ingeniería del futuro</span>
			<span class="sub sub--2">Ahorra tiempo con IA y automatización</span>
		</div>
	</div>
</section>

<style>
	.hero {
		position: relative;
		height: 100vh;
		background: var(--surface);
	}

	.hero__inner {
		position: sticky;
		top: 0;
		height: 100vh;
		display: flex;
		flex-direction: column;
		align-items: center;
		justify-content: center;
		overflow: hidden;
	}

	.hero__title {
		position: relative;
		z-index: 1;
		margin: 0;
		display: flex;
		font-family: "Inter", sans-serif;
		font-weight: 800;
		font-size: clamp(96px, 18vw, 260px);
		line-height: 1;
		letter-spacing: -0.04em;
		user-select: none;
	}

	.letter {
		display: inline-block;
		will-change: transform, opacity;
		background: linear-gradient(
			180deg,
			#0a0a0a 0%,
			#1b1b1b 55%,
			#5d5f5f 100%
		);
		-webkit-background-clip: text;
		background-clip: text;
		-webkit-text-fill-color: transparent;
		color: transparent;
	}

	.hero__subtitle {
		position: relative;
		z-index: 1;
		margin-top: var(--stack-md);
		height: 1.4em;
		width: min(90vw, 720px);
		text-align: center;
	}

	.sub {
		position: absolute;
		left: 0;
		right: 0;
		top: 0;
		font-family: "Inter", sans-serif;
		font-size: clamp(20px, 2.4vw, 32px);
		font-weight: 600;
		line-height: 1.3;
		letter-spacing: -0.01em;
		color: var(--on-surface-variant);
		will-change: opacity, transform;
	}

	.sub--2 {
		opacity: 0;
	}

	/* Scroll-driven: progreso 0–100 % = #hero de "top top" a "bottom bottom".
	   Easings exactos: power1 = cubic-bezier(1/3,0,2/3,1/3) in / (1/3,2/3,2/3,1) out;
	   power2.in = cubic-bezier(1/3,0,2/3,0).
	   Distancias de salida: borde de la letra 80px fuera del viewport; los em son
	   los anchos de avance de Inter 800 (R .6221, A .7297, I .2456, L .5255). */
	@supports (animation-timeline: view()) {
		@media (prefers-reduced-motion: no-preference) {
			.hero {
				height: 300vh;
				view-timeline: --hero block;
			}

			.letter,
			.sub {
				animation-timing-function: linear;
				animation-fill-mode: both;
				animation-timeline: --hero;
				animation-range: contain 0% contain 100%;
			}

			.letter--r {
				--exit: calc(-50vw + 0.4394em - 80px);
				animation-name: hero-exit-1;
			}
			.letter--l {
				--exit: calc(50vw - 0.536em + 80px);
				animation-name: hero-exit-1;
			}
			.letter--a {
				--exit: calc(-50vw - 0.2904em - 80px);
				animation-name: hero-exit-2;
			}
			.letter--i {
				--exit: calc(50vw - 0.2904em + 80px);
				animation-name: hero-exit-2;
			}
			.sub--1 {
				animation-name: hero-sub-1;
			}
			.sub--2 {
				animation-name: hero-sub-2;
			}
		}
	}

	@keyframes hero-exit-1 {
		0% {
			translate: 0;
			opacity: 1;
			animation-timing-function: cubic-bezier(0.3333, 0, 0.6667, 0);
		}
		47.62%,
		100% {
			translate: var(--exit);
			opacity: 0;
		}
	}

	@keyframes hero-exit-2 {
		0%,
		47.62% {
			translate: 0;
			opacity: 1;
			animation-timing-function: cubic-bezier(0.3333, 0, 0.6667, 0);
		}
		95.24%,
		100% {
			translate: var(--exit);
			opacity: 0;
		}
	}

	@keyframes hero-sub-1 {
		0%,
		4.76% {
			opacity: 1;
			animation-timing-function: cubic-bezier(0.3333, 0.6667, 0.6667, 1);
		}
		52.38%,
		100% {
			opacity: 0;
		}
	}

	/* Pico 0.49: en GSAP el fundido de salida arranca antes de que acabe el de entrada. */
	@keyframes hero-sub-2 {
		0%,
		19.05% {
			opacity: 0;
			animation-timing-function: cubic-bezier(0.3333, 0, 0.6667, 0.3333);
		}
		52.38% {
			opacity: 0.49;
			animation-timing-function: cubic-bezier(0.3333, 0.6667, 0.6667, 1);
		}
		100% {
			opacity: 0;
		}
	}
</style>
