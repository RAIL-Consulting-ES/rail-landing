---
// Pie común a todo el sitio. Además de navegación, es el mapa de enlaces
// internos que garantiza que cada página clave está a un clic de cualquier otra.
import { SITE } from "../data/site";

const columns = [
	{
		heading: "Servicios",
		items: [
			{ label: "Consultoría de IA", href: "/consultoria-ia/" },
			{ label: "Estudio de procesos", href: "/estudio-de-procesos/" },
			{ label: "Agentes de IA", href: "/agentes-de-ia/" },
			{
				label: "Automatización de procesos",
				href: "/soluciones/automatizacion-de-procesos/",
			},
			{ label: "Todas las soluciones", href: "/soluciones/" },
		],
	},
	{
		heading: "Sectores",
		items: [
			{ label: "Asesorías y gestorías", href: "/sectores/asesorias-y-gestorias/" },
			{ label: "Despachos de abogados", href: "/sectores/despachos-de-abogados/" },
			{ label: "Inmobiliarias", href: "/sectores/inmobiliarias/" },
			{ label: "Industria y fabricación", href: "/sectores/industria-y-fabricacion/" },
			{ label: "Distribución y logística", href: "/sectores/distribucion-y-logistica/" },
			{ label: "Instaladores y reformas", href: "/sectores/instaladores-y-reformas/" },
		],
	},
	{
		heading: "Recursos",
		items: [
			{ label: "Guías", href: "/guias/" },
			{ label: "Calculadora de ahorro", href: "/calculadora-ahorro-automatizacion/" },
			{ label: "Glosario", href: "/glosario/" },
			{ label: "Preguntas frecuentes", href: "/preguntas-frecuentes/" },
			{ label: "Método", href: "/#expertise" },
		],
	},
	{
		heading: "RAIL",
		items: [
			{ label: "Nosotros", href: "/nosotros/" },
			{ label: "Contacto", href: "/contacto/" },
			{ label: "IA en Sevilla", href: "/consultoria-ia-sevilla/" },
			{ label: "Aviso legal", href: "/aviso-legal/" },
			{ label: "Privacidad", href: "/privacidad/" },
		],
	},
];
---

<footer class="footer">
	<div class="footer__inner">
		<div class="footer__brand">
			<a href="/" class="footer__logo" aria-label="RAIL Consulting, inicio">RAIL</a>
			<p class="footer__tagline">
				{SITE.tagline}. Consultoría de IA, automatización y software a medida.
				Sevilla, España.
			</p>
			<a href={`mailto:${SITE.email}`} class="footer__link">{SITE.email}</a>
		</div>

		{
			columns.map((col) => (
				<nav class="footer__nav" aria-label={col.heading}>
					<span class="footer__heading label-caps">{col.heading}</span>
					<ul class="footer__list">
						{col.items.map((item) => (
							<li>
								<a href={item.href} class="footer__link">
									{item.label}
								</a>
							</li>
						))}
					</ul>
				</nav>
			))
		}
	</div>

	<div class="footer__bottom">
		<p class="footer__copyright">
			© 2026 RAIL Consulting. Todos los derechos reservados.
		</p>
	</div>
</footer>

<style>
	.footer {
		border-top: 1px solid var(--outline-variant);
		background: var(--surface);
		color: var(--on-surface-variant);
		padding: var(--stack-lg) var(--margin-edge) var(--stack-md);
	}

	.footer__inner {
		max-width: var(--container-max);
		margin: 0 auto;
		display: grid;
		grid-template-columns: 1.6fr repeat(4, 1fr);
		gap: var(--stack-md);
	}

	.footer__logo {
		font-weight: 800;
		font-size: 20px;
		letter-spacing: -0.02em;
		color: var(--on-surface);
	}

	.footer__tagline {
		margin: var(--stack-sm) 0;
		font-size: 14px;
		line-height: 1.5;
		max-width: 32ch;
	}

	.footer__heading {
		display: block;
		margin-bottom: var(--stack-sm);
		color: var(--on-surface);
	}

	.footer__list {
		list-style: none;
		margin: 0;
		padding: 0;
		display: flex;
		flex-direction: column;
		gap: 12px;
	}

	.footer__link {
		font-size: 14px;
		color: var(--on-surface-variant);
		transition: color 200ms ease;
	}

	.footer__link:hover {
		color: var(--on-surface);
	}

	.footer__bottom {
		max-width: var(--container-max);
		margin: var(--stack-lg) auto 0;
		padding-top: var(--stack-md);
		border-top: 1px solid var(--outline-variant);
	}

	.footer__copyright {
		margin: 0;
		font-size: 13px;
		color: var(--on-surface-variant);
	}

	@media (max-width: 1100px) {
		.footer__inner {
			grid-template-columns: repeat(4, 1fr);
		}

		.footer__brand {
			grid-column: 1 / -1;
		}
	}

	@media (max-width: 768px) {
		.footer {
			padding: var(--stack-lg) var(--stack-md) var(--stack-md);
		}

		.footer__inner {
			grid-template-columns: 1fr 1fr;
			gap: var(--stack-md);
		}

		.footer__brand {
			grid-column: 1 / -1;
		}

		.footer__bottom {
			margin-top: var(--stack-md);
		}
	}
</style>
