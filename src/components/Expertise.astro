---
const steps = [
	{
		tag: "01 — Estudio",
		title: "Estudio",
		copy: "Nos sentamos con tu equipo y estudiamos cómo trabaja de verdad tu empresa: qué tareas se repiten, dónde se espera y dónde se va el tiempo.",
	},
	{
		tag: "02 — Diagnóstico",
		title: "Diagnóstico",
		copy: "Localizamos los puntos donde la IA o una automatización ahorran más horas y los ordenamos por el tiempo que devuelven a tu equipo.",
	},
	{
		tag: "03 — Solución",
		title: "Solución",
		copy: "Construimos solo lo que hace falta: un agente de IA, una automatización o, si el caso lo pide, software a medida como un ERP o un CRM.",
	},
];

// Un solo diagrama para los tres pasos: una ruta de cuatro puntos que se
// estudia (aparecen las vueltas atrás), se diagnostica (el trabajo se acumula
// antes de un punto) y se resuelve (una vía directa llega antes).
// Cada pieza se anima entre `at` y `at + len`, en fracción del recorrido de
// .exp__track (0→1). `out` es una segunda ventana para salir o cambiar de color.
const w = (at: number, len: number) => `--at:${at.toFixed(4)};--len:${len}`;
const out = (at: number, len: number) => `--at2:${at.toFixed(4)};--len2:${len}`;

const stops = [50, 150, 250, 350];
const LINE_Y = 110;
const DIRECT_Y = 206;
// Ruta completa: 1→3, vuelta al 2, 2→4, vuelta al 2, 2→4
const route = `M50 110 L250 110 L250 124 C250 184 150 184 150 126 L150 110 L350 110 L350 96 C350 28 150 28 150 94 L150 110 L350 110`;

// El punto recorre la ruta durante Estudio y va dejando las vueltas dibujadas.
// Tramos de la ruta que ocupa cada vuelta (medidos sobre el trazo).
const DOT = { at: 0.045, len: 0.245 };
const LOOP_1 = [0.203, 0.345];
const LOOP_2 = [0.563, 0.795];
const during = ([a, b]: number[]) => w(DOT.at + DOT.len * a, DOT.len * (b - a));
const afterLoop = ([, b]: number[]) => w(DOT.at + DOT.len * b - 0.004, 0.012);

// Trabajo acumulado antes del tercer punto [x, y]
const queue: [number, number][] = [
	[90, 110],
	[118, 110],
	[172, 110],
	[185, 110],
	[198, 110],
	[211, 110],
	[224, 110],
	[198, 97],
	[211, 97],
	[224, 97],
	[211, 84],
	[224, 84],
	[224, 71],
	[300, 110],
];
---

<section class="exp" id="expertise" aria-label="Método">
	<div class="exp__track">
		<div class="exp__stage">
			<div class="exp__content">
				<div class="exp__steps">
					{
						steps.map((s) => (
							<article class="step">
								<p class="label-caps step__tag">{s.tag}</p>
								<h2 class="step__title">{s.title}</h2>
								<p class="step__copy">{s.copy}</p>
							</article>
						))
					}
				</div>

				<svg
					class="exp__gfx"
					viewBox="20 16 360 216"
					role="img"
					aria-label="Una misma ruta de trabajo en tres momentos: con sus vueltas atrás, con el trabajo acumulado antes de un punto y, al final, junto a una vía directa que llega antes"
				>
					<!-- La ruta baja un poco mientras está sola y sube cuando llega la vía directa -->
					<g class="settle" style={w(0.655, 0.05)}>
						<path
							class="s-ink draw to-muted"
							style={`${w(0.03, 0.05)};${out(0.66, 0.04)}`}
							d={`M50 ${LINE_Y} L350 ${LINE_Y}`}
							pathLength="100"></path>

						<path
							class="s-accent trail to-muted"
							style={`${during(LOOP_1)};${out(0.31, 0.05)}`}
							d="M250 124 C250 184 150 184 150 126"
							pathLength="100"></path>
						<path
							class="s-accent fade to-muted"
							style={`${afterLoop(LOOP_1)};${out(0.31, 0.05)}`}
							d="M143 135 L150 124 L157 135"></path>
						<path
							class="s-accent trail to-muted"
							style={`${during(LOOP_2)};${out(0.31, 0.05)}`}
							d="M350 96 C350 28 150 28 150 94"
							pathLength="100"></path>
						<path
							class="s-accent fade to-muted"
							style={`${afterLoop(LOOP_2)};${out(0.31, 0.05)}`}
							d="M143 85 L150 96 L157 85"></path>

						{
							stops.map((x, i) => (
								<rect
									class="node fade"
									style={w(0.03 + i * 0.012, 0.02)}
									x={x - 14}
									y={LINE_Y - 14}
									width="28"
									height="28"
									rx="7"
								/>
							))
						}

						<!-- Estudio: el punto recorre la ruta -->
						<path
							class="dot dot--ink travel leaves"
							style={`${w(DOT.at, DOT.len)};${out(0.3, 0.03)}`}
							d={route}
							pathLength="100"></path>

						<!-- Diagnóstico: el trabajo se acumula antes del tercer punto -->
						{
							queue.map(([x, y], k) => (
								<circle
									class="f-ink queue"
									style={`${w(0.36 + k * 0.012, 0.08)};${out(0.645, 0.05)};--dx:${50 - x}px;--dy:${LINE_Y - y}px;--ox:${350 - x}px`}
									cx={x}
									cy={y}
									r="5.5"
								/>
							))
						}
						<circle
							class="s-accent ring lock"
							style={`${w(0.56, 0.05)};${out(0.645, 0.03)}`}
							cx="250"
							cy={LINE_Y}
							r="32"></circle>

						<!-- Solución: la ruta de antes se vuelve a recorrer, despacio -->
						<path
							class="dot dot--muted travel arrives"
							style={w(0.74, 0.24)}
							d={route}
							pathLength="100"></path>
					</g>

					<!-- Solución: la vía directa -->
					<path
						class="s-accent draw"
						style={w(0.69, 0.05)}
						d={`M50 ${DIRECT_Y} L350 ${DIRECT_Y}`}
						pathLength="100"></path>
					<rect class="node fade" style={w(0.69, 0.02)} x="38" y={DIRECT_Y - 12} width="24" height="24" rx="6"
					></rect>
					<rect
						class="node node--end fade"
						style={w(0.72, 0.02)}
						x="338"
						y={DIRECT_Y - 12}
						width="24"
						height="24"
						rx="6"></rect>
					<path
						class="dot dot--accent travel arrives"
						style={w(0.74, 0.05)}
						d={`M50 ${DIRECT_Y} L350 ${DIRECT_Y}`}
						pathLength="100"></path>
				</svg>

				<a href="/soluciones/" class="exp__cta">Ver todas las soluciones</a>
			</div>
		</div>
	</div>
</section>

<style>
	@property --p {
		syntax: "<number>";
		inherits: true;
		initial-value: 1;
	}

	/* Base = versión estática: es lo que se ve con prefers-reduced-motion o en
	   navegadores sin scroll-driven animations. Los tres textos van apilados y
	   el diagrama se muestra en su estado final. La versión animada va abajo. */
	.exp {
		position: relative;
		z-index: 4;
	}

	.exp__content {
		display: flex;
		flex-direction: column;
		align-items: center;
		text-align: center;
		padding: var(--stack-lg) var(--margin-edge);
		color: var(--on-surface);
	}

	.exp__steps {
		display: grid;
		gap: var(--stack-lg);
	}

	.step__tag {
		color: var(--on-surface-variant);
		margin: 0 0 var(--stack-sm);
	}

	.step__title {
		margin: 0;
		font-family: "Inter", sans-serif;
		font-size: clamp(56px, 9vw, 120px);
		font-weight: 800;
		letter-spacing: -0.04em;
		line-height: 1;
		background: linear-gradient(180deg, #0a0a0a 0%, #1b1b1b 60%, #5d5f5f 100%);
		-webkit-background-clip: text;
		background-clip: text;
		-webkit-text-fill-color: transparent;
		color: transparent;
	}

	.step__copy {
		max-width: 640px;
		margin: var(--stack-md) auto 0;
		font-size: clamp(16px, 1.5vw, 20px);
		line-height: 1.6;
		color: var(--on-surface-variant);
	}

	.exp__gfx {
		display: block;
		width: min(80vw, 620px);
		max-height: 34vh;
		margin-top: clamp(20px, 5vh, 64px);
		overflow: visible;
	}

	.exp__cta {
		margin-top: clamp(16px, 3vh, 32px);
		background: var(--tertiary);
		color: var(--on-tertiary);
		padding: 14px 28px;
		border-radius: var(--r);
		font-weight: 600;
		font-size: 14px;
		letter-spacing: 0.02em;
		transition:
			transform 200ms ease,
			filter 200ms ease;
	}

	.exp__cta:hover {
		transform: scale(1.02);
		filter: brightness(0.97);
	}

	/* Diagrama: línea y puntos, el mismo vocabulario que el tren del header.
	   --p es el avance (1 = estado final, que es lo que se ve sin animación).
	   Cada pieza calcula sus tramos locales: --t lineal, para los recorridos, y
	   --e, que desacelera al llegar (1 − (1 − t)⁴). Los "2" son la segunda
	   ventana, para salir o cambiar de color. */
	.exp__gfx * {
		--t: clamp(0, (var(--p) - var(--at, 0)) / var(--len, 1), 1);
		--e: calc(1 - pow(1 - var(--t), 4));
		--t2: clamp(0, (var(--p) - var(--at2, 2)) / var(--len2, 1), 1);
		--e2: calc(1 - pow(1 - var(--t2), 4));
	}

	.s-ink,
	.s-accent {
		fill: none;
		stroke-width: 1.5;
		stroke-linecap: round;
		stroke-linejoin: round;
	}
	.s-ink {
		--from: var(--on-surface);
		stroke: var(--from);
	}
	.s-accent {
		--from: var(--tertiary);
		stroke: var(--from);
		stroke-width: 2.5;
	}
	.f-ink {
		fill: var(--on-surface);
	}
	.node {
		fill: var(--surface);
		stroke: var(--on-surface);
		stroke-width: 1.5;
	}
	.node--end {
		fill: var(--on-surface);
	}
	.ring {
		stroke-width: 3;
	}

	/* Comportamientos */
	.fade {
		opacity: var(--e);
	}
	.draw {
		stroke-dasharray: 100;
		stroke-dashoffset: calc(100 * (1 - var(--e)));
	}
	/* Se dibuja al paso del punto que la recorre */
	.trail {
		stroke-dasharray: 100;
		stroke-dashoffset: calc(100 * (1 - var(--t)));
	}
	/* Lo ya estudiado pasa a gris: es "la ruta de antes" */
	.to-muted {
		stroke: color-mix(in srgb, var(--outline) calc(var(--e2) * 100%), var(--from));
	}
	.settle {
		translate: 0 calc(24px * (1 - var(--e)));
	}
	.queue {
		opacity: calc(min(1, var(--t) * 6) * (1 - var(--e2)));
		translate: calc(var(--dx) * (1 - var(--e)) + var(--ox) * var(--e2))
			calc(var(--dy) * (1 - var(--e)) + var(--dy) * var(--e2));
	}
	.lock {
		transform-box: fill-box;
		transform-origin: center;
		opacity: calc(var(--e) * (1 - var(--e2)));
		scale: calc(1.7 - 0.7 * var(--e));
	}

	/* Punto que recorre un trazo: guion de longitud ~0 con extremos redondos */
	.dot {
		fill: none;
		stroke-width: 11;
		stroke-linecap: round;
		stroke-dasharray: 0.01 200;
	}
	.dot--ink {
		stroke: var(--on-surface);
	}
	.dot--muted {
		stroke: var(--outline);
	}
	.dot--accent {
		stroke: var(--tertiary);
		stroke-width: 13;
	}
	.travel {
		stroke-dashoffset: calc(-100 * var(--t));
	}
	.leaves {
		opacity: calc(min(1, var(--t) * 40) * (1 - var(--e2)));
	}
	.arrives {
		opacity: min(1, var(--t) * 40);
	}

	@media (max-width: 640px) {
		.exp__gfx {
			width: 92vw;
		}
	}

	/* Versión animada. Progreso 0–100 % = .exp__track de "top top" a
	   "bottom bottom" (550vh de scroll). El escenario queda fijo: solo entra
	   una vez, cambian los textos y el diagrama se transforma.
	     0–10 %   entra el bloque (como antes entraba Estudio)
	     0–31 %   Estudio      · 33.5–64.5 % Diagnóstico · 67–100 % Solución */
	@supports (animation-timeline: view()) {
		@media (prefers-reduced-motion: no-preference) {
			.exp {
				margin-top: -150vh;
			}

			.exp__track {
				height: 650vh;
				view-timeline: --exp block;
			}

			.exp__stage {
				position: sticky;
				top: 0;
				height: 100vh;
				overflow: hidden;
			}

			.exp__content,
			.step,
			.exp__gfx,
			.exp__cta {
				animation-timing-function: linear;
				animation-fill-mode: both;
				animation-timeline: --exp;
				animation-range: contain 0% contain 100%;
			}

			.exp__content {
				height: 100%;
				justify-content: center;
				/* hueco superior para el header y el tren */
				padding: 104px var(--margin-edge) 0;
				animation-name: exp-enter;
				animation-timing-function: cubic-bezier(0.3333, 1, 0.6667, 1);
				animation-range: contain 0% contain 10%;
			}

			/* Los tres textos ocupan el mismo sitio y se relevan */
			.exp__steps {
				gap: 0;
			}
			.step {
				grid-area: 1 / 1;
				will-change: opacity, filter;
			}
			.step:nth-child(1) {
				animation-name: step-1;
			}
			.step:nth-child(2) {
				animation-name: step-2;
			}
			.step:nth-child(3) {
				animation-name: step-3;
			}

			.exp__gfx {
				animation-name: gfx-run;
			}

			.exp__cta {
				animation-name: exp-cta;
				animation-timing-function: cubic-bezier(0.16, 1, 0.3, 1);
				animation-range: contain 70% contain 73.5%;
			}
		}

		@media (prefers-reduced-motion: no-preference) and (max-height: 760px) {
			.exp__gfx {
				max-height: 27vh;
			}
		}
	}

	@keyframes exp-enter {
		from {
			opacity: 0;
			translate: 0 100%;
		}
		to {
			opacity: 1;
			translate: 0 0;
		}
	}

	/* Relevo de textos: sale rápido hacia arriba, entra desde abajo y enfoca.
	   visibility evita que el texto oculto se pueda seleccionar o leer dos veces. */
	@keyframes step-1 {
		0%,
		31% {
			opacity: 1;
			translate: 0 0;
			filter: blur(0);
			visibility: visible;
			animation-timing-function: cubic-bezier(0.4, 0, 1, 1);
		}
		33.5%,
		100% {
			opacity: 0;
			translate: 0 -14px;
			filter: blur(6px);
			visibility: hidden;
		}
	}

	@keyframes step-2 {
		0%,
		33.5% {
			opacity: 0;
			translate: 0 14px;
			filter: blur(6px);
			visibility: hidden;
			animation-timing-function: cubic-bezier(0.16, 1, 0.3, 1);
		}
		37%,
		64.5% {
			opacity: 1;
			translate: 0 0;
			filter: blur(0);
			visibility: visible;
			animation-timing-function: cubic-bezier(0.4, 0, 1, 1);
		}
		67%,
		100% {
			opacity: 0;
			translate: 0 -14px;
			filter: blur(6px);
			visibility: hidden;
		}
	}

	@keyframes step-3 {
		0%,
		67% {
			opacity: 0;
			translate: 0 14px;
			filter: blur(6px);
			visibility: hidden;
			animation-timing-function: cubic-bezier(0.16, 1, 0.3, 1);
		}
		70.5%,
		100% {
			opacity: 1;
			translate: 0 0;
			filter: blur(0);
			visibility: visible;
		}
	}

	@keyframes exp-cta {
		from {
			opacity: 0;
			translate: 0 12px;
			visibility: hidden;
		}
		to {
			opacity: 1;
			translate: 0 0;
			visibility: visible;
		}
	}

	@keyframes gfx-run {
		from {
			--p: 0;
		}
		to {
			--p: 1;
		}
	}
</style>
