---
// Bloque que cierra la home, después del CTA: qué es RAIL en un párrafo, el
// índice de todo el sitio y las preguntas frecuentes. Es el texto que leen
// buscadores y asistentes de IA; va al final para no interrumpir el método.
import { getCollection } from "astro:content";
import { homeFaq } from "../data/faq";
import { guidePath, pagePath } from "../lib/pages";

const sectores = (await getCollection("paginas"))
	.filter((p) => p.data.kind === "sector")
	.sort((a, b) => a.data.order - b.data.order);

const guias = (await getCollection("guias")).sort(
	(a, b) => a.data.order - b.data.order,
);

const index = [
	{
		label: "Servicios",
		links: [
			{ text: "Consultoría de IA", href: "/consultoria-ia/" },
			{ text: "Estudio de procesos", href: "/estudio-de-procesos/" },
			{ text: "Agentes de IA", href: "/agentes-de-ia/" },
			{
				text: "Automatización de procesos",
				href: "/soluciones/automatizacion-de-procesos/",
			},
			{ text: "Todas las soluciones", href: "/soluciones/" },
		],
	},
	{
		label: "Sectores",
		links: [
			...sectores.map((s) => ({ text: s.data.short, href: pagePath(s.id) })),
			{ text: "Empresas de Sevilla", href: "/consultoria-ia-sevilla/" },
		],
	},
	{
		label: "Guías",
		links: guias.map((g) => ({ text: g.data.short, href: guidePath(g.id) })),
	},
	{
		label: "Recursos",
		links: [
			{ text: "Calculadora de ahorro", href: "/calculadora-ahorro-automatizacion/" },
			{ text: "Glosario", href: "/glosario/" },
			{ text: "Todas las preguntas frecuentes", href: "/preguntas-frecuentes/" },
			{ text: "Todas las guías", href: "/guias/" },
		],
	},
];
---

<div class="hx">
	<section class="hx__block" aria-labelledby="hx-que">
		<h2 class="hx__h2" id="hx-que">
			Consultoría de IA y automatización para empresas
		</h2>
		<div class="hx__statement">
			<p class="hx__lead">
				RAIL Consulting es una consultora de ingeniería de Sevilla. Estudiamos
				cómo trabaja tu empresa, detectamos dónde se pierde tiempo y lo
				recuperamos con inteligencia artificial, automatización y software a
				medida.
			</p>
			<p class="hx__text">
				No vendemos una herramienta ni un programa concreto. Vendemos horas de
				vuelta: las que hoy se van en copiar datos, rehacer documentos y
				esperar respuestas. Por eso empezamos siempre midiendo, y solo
				construimos lo que los números justifican.
			</p>
		</div>
	</section>

	<nav class="hx__index" aria-label="Índice del sitio">
		{
			index.map((row) => (
				<div class="hx__block hx__row">
					<h3 class="label-caps hx__label">{row.label}</h3>
					<ul class="hx__links">
						{row.links.map((l) => (
							<li>
								<a href={l.href}>{l.text}</a>
							</li>
						))}
					</ul>
				</div>
			))
		}
	</nav>

	<section class="hx__block" aria-labelledby="hx-faq">
		<h2 class="hx__h2" id="hx-faq">Preguntas frecuentes</h2>
		<div class="hx__faq">
			{
				homeFaq.map((f) => (
					<details class="hx__q">
						<summary>
							<h3>{f.question}</h3>
						</summary>
						<p>{f.answer}</p>
					</details>
				))
			}
		</div>
	</section>
</div>

<style>
	/* Un solo eje: títulos y etiquetas en la columna izquierda, contenido en la
	   derecha. Las filas se separan con una línea fina, como el resto del sitio. */
	.hx {
		position: relative;
		z-index: 4;
		background: var(--surface);
		padding: var(--stack-lg) var(--margin-edge) 0;
	}

	/* Timeline de scroll que usa el tren del header (RailTimeline.astro) */
	@supports (animation-timeline: view()) {
		@media (prefers-reduced-motion: no-preference) {
			.hx {
				view-timeline: --hx block;
			}
		}
	}

	.hx__block {
		max-width: 1200px;
		margin: 0 auto;
		display: grid;
		grid-template-columns: minmax(0, 4fr) minmax(0, 8fr);
		column-gap: var(--stack-lg);
		padding: var(--stack-lg) 0;
		border-top: 1px solid var(--outline-variant);
	}

	.hx > .hx__block:first-child {
		border-top: none;
		padding-top: 0;
	}

	.hx__row {
		padding: 28px 0;
		align-items: baseline;
	}

	.hx__h2 {
		margin: 0;
		font-size: clamp(28px, 3.2vw, 44px);
		font-weight: 800;
		letter-spacing: -0.035em;
		line-height: 1.06;
		text-wrap: balance;
	}

	.hx__statement {
		max-width: 62ch;
	}

	.hx__lead {
		margin: 0 0 var(--stack-sm);
		font-size: clamp(19px, 1.7vw, 23px);
		font-weight: 500;
		line-height: 1.45;
		letter-spacing: -0.015em;
		text-wrap: pretty;
	}

	.hx__text {
		margin: 0;
		font-size: 17px;
		line-height: 1.65;
		color: var(--on-surface-variant);
		text-wrap: pretty;
	}

	.hx__label {
		margin: 0;
		color: var(--on-surface-variant);
	}

	.hx__links {
		list-style: none;
		margin: 0;
		padding: 0;
		columns: 2;
		column-gap: var(--stack-md);
	}

	.hx__links li {
		break-inside: avoid;
		padding: 5px 0;
	}

	.hx__links a {
		font-size: 17px;
		font-weight: 500;
		line-height: 1.4;
		letter-spacing: -0.01em;
		text-decoration: underline;
		text-decoration-color: transparent;
		text-decoration-thickness: 2px;
		text-underline-offset: 4px;
		transition: text-decoration-color 160ms ease-out;
	}

	.hx__links a:hover {
		text-decoration-color: var(--tertiary);
	}

	.hx__q {
		border-bottom: 1px solid var(--outline-variant);
	}

	.hx__q:first-child {
		border-top: 1px solid var(--outline-variant);
	}

	.hx__q summary {
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: var(--stack-md);
		padding: 20px 0;
		cursor: pointer;
		list-style: none;
	}

	.hx__q summary::-webkit-details-marker {
		display: none;
	}

	.hx__q summary h3 {
		margin: 0;
		font-size: 18px;
		font-weight: 600;
		line-height: 1.35;
		letter-spacing: -0.01em;
	}

	/* Signo +: dos trazos; el vertical se encoge al abrir y queda un −. */
	.hx__q summary::after {
		content: "";
		flex: none;
		width: 14px;
		height: 14px;
		background:
			linear-gradient(currentColor, currentColor) center / 100% 2px no-repeat,
			linear-gradient(currentColor, currentColor) center / 2px 100% no-repeat;
		transition: background-size 200ms cubic-bezier(0.16, 1, 0.3, 1);
	}

	.hx__q[open] summary::after {
		background-size:
			100% 2px,
			2px 0;
	}

	.hx__q p {
		margin: 0;
		padding: 0 var(--stack-md) 24px 0;
		max-width: 68ch;
		font-size: 16px;
		line-height: 1.65;
		color: var(--on-surface-variant);
	}

	@media (max-width: 900px) {
		.hx__block {
			grid-template-columns: 1fr;
			row-gap: var(--stack-md);
		}

		.hx__row {
			row-gap: var(--stack-sm);
		}
	}

	@media (max-width: 768px) {
		.hx {
			padding: var(--stack-lg) var(--stack-md) 0;
		}

		.hx__block {
			padding: calc(var(--stack-lg) * 0.7) 0;
		}

		.hx__row {
			padding: 24px 0;
		}

		.hx__links {
			columns: 1;
		}
	}
</style>
