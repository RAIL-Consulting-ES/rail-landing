---
// Plantilla de las páginas de lectura (servicios, sectores, guías, glosario,
// preguntas frecuentes). Cada página es una línea: las secciones son sus
// estaciones, a la izquierda, y el texto corre a la derecha. Cierra en el
// mismo bloque de contacto que la home.
import FinalCTA from "./FinalCTA.astro";
import type { Crumb, Faq } from "../lib/schema";
import { type PageRef, formatDate } from "../lib/pages";

interface Props {
	crumbs: Crumb[];
	h1: string;
	/** Respuesta directa: el primer párrafo, el que se cita. */
	answer: string;
	/** Línea de autoría y fecha (guías). */
	byline?: { name: string; href: string; published: string; updated: string };
	updated?: string;
	toc?: { slug: string; text: string }[];
	faq: Faq[];
	related: PageRef[];
	cta?: { title?: string; copy?: string; label?: string };
}

const {
	crumbs,
	h1,
	answer,
	byline,
	updated,
	toc = [],
	faq,
	related,
	cta = {
		copy: "Cuéntanos cómo trabajáis y te decimos, con números, qué merece la pena automatizar y qué no.",
	},
} = Astro.props;

const stations = [
	...toc,
	...(faq.length > 0 ? [{ slug: "preguntas", text: "Preguntas frecuentes" }] : []),
];
const hasLine = stations.length > 2;

const groupLabel: Record<PageRef["group"], string> = {
	servicio: "Servicio",
	sector: "Sector",
	local: "Sevilla",
	solucion: "Solución",
	guia: "Guía",
	base: "RAIL",
};
---

<main id="contenido" class="cp">
	<header class="cp__head">
		<nav class="cp__crumbs label-caps" aria-label="Migas de pan">
			<a href="/">Inicio</a>
			{
				crumbs.map((c, i) => (
					<>
						<span aria-hidden="true">/</span>
						{i === crumbs.length - 1 ? (
							<span aria-current="page">{c.name}</span>
						) : (
							<a href={c.path}>{c.name}</a>
						)}
					</>
				))
			}
		</nav>
		<h1 class="cp__title">{h1}</h1>
	</header>

	<div class:list={["cp__body", { "cp__body--plain": !hasLine }]}>
		{
			hasLine && (
				<nav class="cp__line" aria-label="Secciones de la página">
					<ol>
						{stations.map((s) => (
							<li>
								<a href={`#${s.slug}`}>{s.text}</a>
							</li>
						))}
					</ol>
				</nav>
			)
		}

		<div class="cp__main">
			<p class="cp__answer">{answer}</p>
			{
				byline && (
					<p class="cp__meta">
						<a href={byline.href}>{byline.name}</a> ·{" "}
						<time datetime={byline.published}>{formatDate(byline.published)}</time>
						{byline.updated !== byline.published && (
							<>
								{" "}
								· actualizado el{" "}
								<time datetime={byline.updated}>{formatDate(byline.updated)}</time>
							</>
						)}
					</p>
				)
			}

			<article class="prose">
				<slot />
			</article>

			{
				faq.length > 0 && (
					<section class="prose" aria-labelledby="preguntas">
						<h2 id="preguntas">Preguntas frecuentes</h2>
						{faq.map((f) => (
							<>
								<h3>{f.question}</h3>
								<p>{f.answer}</p>
							</>
						))}
					</section>
				)
			}

			{
				related.length > 0 && (
					<nav class="cp__next" aria-labelledby="siguiente">
						<h2 class="label-caps" id="siguiente">
							Sigue leyendo
						</h2>
						<ul>
							{related.map((r) => (
								<li>
									<a href={r.path}>
										<span class="label-caps">{groupLabel[r.group]}</span>
										<span class="cp__next-title">{r.title}</span>
										<svg viewBox="0 0 20 12" aria-hidden="true">
											<path d="M0 6h18M13 1l5 5-5 5" />
										</svg>
									</a>
								</li>
							))}
						</ul>
					</nav>
				)
			}

			{
				updated && (
					<p class="cp__meta cp__meta--end">
						Última revisión:{" "}
						<time datetime={updated}>{formatDate(updated)}</time> ·{" "}
						<a href="/nosotros/">RAIL Consulting</a>, Sevilla.
					</p>
				)
			}
		</div>
	</div>
</main>

<FinalCTA {...cta} />

<script>
	// Enciende las estaciones de la línea según la sección que se está leyendo.
	const line = document.querySelector(".cp__line");
	if (line) {
		const items = [...line.querySelectorAll("li")];
		const targets = items.map((li) =>
			document.getElementById(
				decodeURIComponent(li.querySelector("a")!.hash.slice(1)),
			),
		);
		let queued = false;
		const update = () => {
			queued = false;
			let current = -1;
			targets.forEach((t, i) => {
				if (t && t.getBoundingClientRect().top <= 180) current = i;
			});
			items.forEach((li, i) => {
				li.classList.toggle("is-past", i < current);
				li.classList.toggle("is-current", i === current);
				const a = li.querySelector("a")!;
				if (i === current) a.setAttribute("aria-current", "location");
				else a.removeAttribute("aria-current");
			});
		};
		addEventListener(
			"scroll",
			() => {
				if (!queued) {
					queued = true;
					requestAnimationFrame(update);
				}
			},
			{ passive: true },
		);
		update();
	}
</script>

<style>
	.cp {
		max-width: 1200px;
		margin: 0 auto;
		padding: 168px var(--margin-edge) 120px;
	}

	.cp__crumbs {
		display: flex;
		flex-wrap: wrap;
		gap: 10px;
		line-height: 1.5;
		color: var(--on-surface-variant);
	}

	.cp__crumbs a {
		transition: color 160ms ease-out;
	}

	.cp__crumbs a:hover,
	.cp__crumbs [aria-current] {
		color: var(--on-surface);
	}

	.cp__title {
		margin: var(--stack-md) 0 0;
		max-width: 18ch;
		font-size: clamp(40px, 6.2vw, 80px);
		font-weight: 800;
		letter-spacing: -0.04em;
		line-height: 1.02;
		text-wrap: balance;
	}

	/* Línea a la izquierda, lectura a la derecha. */
	.cp__body {
		display: grid;
		grid-template-columns: 240px minmax(0, 680px);
		column-gap: 96px;
		margin-top: var(--stack-lg);
		padding-top: var(--stack-lg);
		border-top: 1px solid var(--outline-variant);
	}

	.cp__body--plain {
		grid-template-columns: minmax(0, 680px);
	}

	.cp__line {
		position: sticky;
		top: 128px;
		align-self: start;
		max-height: calc(100vh - 160px);
		overflow-y: auto;
	}

	.cp__line ol {
		list-style: none;
		margin: 0;
		padding: 0;
	}

	.cp__line li {
		position: relative;
		padding: 0 0 20px 28px;
	}

	.cp__line li:last-child {
		padding-bottom: 0;
	}

	/* Estación: el mismo punto que la línea de la home. */
	.cp__line li::before {
		content: "";
		position: absolute;
		z-index: 1;
		left: 0;
		top: 5px;
		width: 10px;
		height: 10px;
		border-radius: 50%;
		background: var(--surface);
		border: 2px solid var(--outline-variant);
		transition:
			background 200ms ease-out,
			border-color 200ms ease-out,
			box-shadow 200ms ease-out;
	}

	/* Tramo hasta la estación siguiente. */
	.cp__line li:not(:last-child)::after {
		content: "";
		position: absolute;
		left: 4px;
		top: 10px;
		bottom: -10px;
		width: 2px;
		background: var(--outline-variant);
		transition: background 200ms ease-out;
	}

	.cp__line li.is-past::before,
	.cp__line li.is-current::before {
		background: var(--tertiary);
		border-color: var(--tertiary);
	}

	.cp__line li.is-current::before {
		box-shadow: 0 0 0 4px color-mix(in srgb, var(--tertiary) 28%, transparent);
	}

	.cp__line li.is-past::after {
		background: var(--tertiary);
	}

	.cp__line a {
		display: block;
		font-size: 14px;
		line-height: 1.4;
		color: var(--on-surface-variant);
		transition: color 160ms ease-out;
	}

	.cp__line a:hover,
	.cp__line li.is-current a {
		color: var(--on-surface);
	}

	.cp__line li.is-current a {
		font-weight: 600;
	}

	.cp__answer {
		margin: 0;
		font-size: clamp(20px, 2vw, 24px);
		font-weight: 500;
		line-height: 1.42;
		letter-spacing: -0.015em;
		text-wrap: pretty;
	}

	.cp__meta {
		margin: var(--stack-sm) 0 0;
		font-size: 14px;
		line-height: 1.5;
		color: var(--on-surface-variant);
	}

	.cp__meta a {
		color: var(--on-surface);
		text-decoration: underline;
		text-decoration-color: var(--tertiary);
		text-decoration-thickness: 2px;
		text-underline-offset: 3px;
	}

	.cp__meta--end {
		margin-top: var(--stack-lg);
	}

	/* Siguientes paradas */
	.cp__next {
		margin-top: 96px;
	}

	.cp__next h2 {
		margin: 0 0 var(--stack-sm);
		color: var(--on-surface-variant);
	}

	.cp__next ul {
		list-style: none;
		margin: 0;
		padding: 0;
		border-top: 2px solid var(--on-surface);
	}

	.cp__next a {
		display: grid;
		grid-template-columns: 88px minmax(0, 1fr) 20px;
		align-items: baseline;
		column-gap: var(--stack-sm);
		padding: 18px 0;
		border-bottom: 1px solid var(--outline-variant);
	}

	.cp__next .label-caps {
		line-height: 1.5;
		color: var(--on-surface-variant);
	}

	.cp__next-title {
		font-size: 18px;
		font-weight: 600;
		line-height: 1.35;
		letter-spacing: -0.01em;
		text-decoration: underline;
		text-decoration-color: transparent;
		text-decoration-thickness: 2px;
		text-underline-offset: 4px;
		transition: text-decoration-color 160ms ease-out;
	}

	.cp__next a:hover .cp__next-title {
		text-decoration-color: var(--tertiary);
	}

	.cp__next svg {
		width: 20px;
		height: 12px;
		fill: none;
		stroke: currentColor;
		stroke-width: 1.5;
		transition: translate 200ms cubic-bezier(0.16, 1, 0.3, 1);
	}

	.cp__next a:hover svg {
		translate: 4px 0;
	}

	@media (max-width: 1023px) {
		.cp__body {
			grid-template-columns: minmax(0, 680px);
		}

		/* En pantallas estrechas manda el texto: la línea no cabe al lado. */
		.cp__line {
			display: none;
		}
	}

	@media (max-width: 768px) {
		.cp {
			padding: 128px var(--stack-md) var(--stack-lg);
		}

		.cp__body {
			margin-top: 48px;
			padding-top: 48px;
		}

		.cp__next a {
			grid-template-columns: minmax(0, 1fr) 20px;
		}

		.cp__next a .label-caps {
			grid-column: 1 / -1;
			margin-bottom: 4px;
		}
	}

	@media (prefers-reduced-motion: reduce) {
		.cp__line li::before,
		.cp__line li::after,
		.cp__next svg {
			transition: none;
		}
	}
</style>
