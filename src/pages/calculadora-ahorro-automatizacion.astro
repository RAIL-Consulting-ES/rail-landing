---
// Calculadora de ahorro: la misma cuenta de la guía, interactiva. Todo el
// cálculo ocurre en el navegador; no se envía ningún dato.
import Layout from "../layouts/Layout.astro";
import Header from "../components/Header.astro";
import FinalCTA from "../components/FinalCTA.astro";
import { faqNode } from "../lib/schema";

const path = "/calculadora-ahorro-automatizacion/";
const url = new URL(path, Astro.site).href;
const crumbs = [{ name: "Calculadora de ahorro", path }];
const UPDATED = "2026-11-12";

const faq = [
	{
		question: "¿Cómo calcula el ahorro esta calculadora?",
		answer: "Multiplica las veces que se hace la tarea a la semana por los minutos que dura y por las semanas de trabajo al año, para obtener las horas anuales. Aplica el porcentaje que se estima automatizable y multiplica las horas recuperadas por el coste de la hora. Si se indica una inversión, calcula además en cuántos meses se recupera.",
	},
	{
		question: "¿Qué coste por hora debo introducir?",
		answer: "El coste total para la empresa de la persona que hace la tarea: salario bruto anual más cotizaciones, dividido entre las horas que trabaja al año. Es más alto que el salario por hora que percibe el empleado.",
	},
	{
		question: "¿Qué porcentaje automatizable es realista?",
		answer: "Depende de lo regular que sea la tarea. Cuanto más iguales son los casos entre sí, mayor es la parte que se automatiza. Lo prudente es hacer la cuenta con una cifra conservadora y otra optimista: si solo compensa con la optimista, no es buena candidata.",
	},
	{
		question: "¿Se guardan los datos que introduzco?",
		answer: "No. El cálculo se hace en tu navegador y los datos no se envían a ningún servidor.",
	},
];

const schema = [
	{
		"@type": "WebApplication",
		"@id": `${url}#app`,
		name: "Calculadora de ahorro de una automatización",
		url,
		applicationCategory: "BusinessApplication",
		operatingSystem: "Cualquiera (navegador web)",
		inLanguage: "es-ES",
		description:
			"Calcula cuántas horas y cuánto dinero ahorra al año automatizar una tarea repetitiva y en cuántos meses se recupera la inversión.",
		offers: { "@type": "Offer", price: "0", priceCurrency: "EUR" },
		provider: { "@id": "https://www.railconsulting.es/#organization" },
	},
	faqNode(url, faq),
];
---

<Layout
	title="Calculadora de ahorro de una automatización (ROI) | RAIL Consulting"
	description="Calcula gratis cuántas horas y cuánto dinero ahorra al año automatizar una tarea repetitiva, y en cuántos meses se recupera la inversión. Sin registro."
	breadcrumbs={crumbs}
	schema={schema}
	modified={UPDATED}
>
	<Header />

	<main id="contenido" class="calc">
		<header>
			<nav class="calc__crumbs label-caps" aria-label="Migas de pan">
				<a href="/">Inicio</a>
				<span aria-hidden="true">/</span>
				<span aria-current="page">Calculadora de ahorro</span>
			</nav>
			<h1 class="calc__title">Calculadora de ahorro de una automatización</h1>
			<p class="calc__lead">
				Elige una tarea que se repita en tu empresa y completa la frase. Verás
				las horas y el dinero que se van en ella cada año, y lo que
				recuperarías al automatizarla.
			</p>
		</header>

		<div class="calc__tool">
			<form class="calc__form" id="calc-form" novalidate>
				<p class="calc__say">
					La tarea se hace
					<input
						type="number"
						name="times"
						value="120"
						min="0"
						step="1"
						inputmode="numeric"
						aria-label="Veces que se hace la tarea a la semana"
					/>
					veces a la semana y dura
					<input
						type="number"
						name="minutes"
						value="5"
						min="0"
						step="0.5"
						inputmode="decimal"
						aria-label="Minutos que dura cada vez"
					/>
					minutos cada vez. Se trabaja
					<input
						type="number"
						name="weeks"
						value="48"
						min="1"
						max="52"
						step="1"
						inputmode="numeric"
						aria-label="Semanas de trabajo al año"
					/>
					semanas al año y cada hora le cuesta a la empresa
					<input
						type="number"
						name="rate"
						value="22"
						min="0"
						step="0.5"
						inputmode="decimal"
						aria-label="Coste de la hora para la empresa, en euros"
					/>
					€.
				</p>
				<p class="calc__hint">
					El coste de la hora es el salario bruto más las cotizaciones, dividido
					entre las horas que se trabajan al año.
				</p>

				<label class="calc__share">
					<span class="calc__say">
						Se puede automatizar el
						<output id="share-out">75 %</output>
						de la tarea.
					</span>
					<input type="range" name="share" value="75" min="10" max="100" step="5" />
					<span class="calc__hint">
						Si dudas, prueba una cifra prudente y otra optimista.
					</span>
				</label>

				<p class="calc__say calc__say--optional">
					Opcional: construirla cuesta
					<input
						type="number"
						name="invest"
						min="0"
						step="100"
						inputmode="numeric"
						placeholder="6000"
						aria-label="Inversión inicial, en euros"
					/>
					€ y mantenerla
					<input
						type="number"
						name="upkeep"
						min="0"
						step="50"
						inputmode="numeric"
						placeholder="900"
						aria-label="Mantenimiento al año, en euros"
					/>
					€ al año.
				</p>
			</form>

			<section class="calc__result" aria-live="polite" aria-label="Resultado">
				<p class="calc__out">
					Recuperas
					<strong><span id="r-hours">360</span> horas</strong>
					al año, que son
					<strong><span id="r-money">7.920</span> €</strong>.
				</p>

				<div class="calc__track" id="r-track" aria-hidden="true">
					<span class="calc__track-fill"></span>
				</div>
				<p class="calc__legend">
					La vía entera son las <span id="r-total">480</span> horas que la tarea
					consume hoy al año; el tramo verde, las que recuperas. Cada marca es
					una semana de trabajo.
				</p>

				<p class="calc__fact">
					Equivale a <span id="r-weeks">9</span> semanas de trabajo de una
					persona.
				</p>
				<p class="calc__fact" id="r-payback" hidden></p>

				<a href="/contacto/" class="calc__btn label-caps">Medirlo en tu empresa</a>
				<p class="calc__hint">
					El cálculo se hace en tu navegador. No se envía ningún dato.
				</p>
			</section>
		</div>

		<article class="prose calc__prose">
			<h2>Cómo se calcula</h2>
			<p>
				La calculadora aplica la misma fórmula que usamos en un
				<a href="/estudio-de-procesos/">estudio de procesos</a>:
			</p>
			<ul>
				<li>
					<strong>Horas al año</strong> = veces a la semana × minutos ÷ 60 ×
					semanas de trabajo.
				</li>
				<li>
					<strong>Horas recuperadas</strong> = horas al año × parte que se
					automatiza.
				</li>
				<li>
					<strong>Ahorro anual</strong> = horas recuperadas × coste de la hora.
				</li>
				<li>
					<strong>Plazo de recuperación</strong> = inversión ÷ (ahorro anual −
					mantenimiento) × 12 meses.
				</li>
			</ul>
			<p>
				El resultado es una estimación: sirve para comparar tareas entre sí y
				decidir por cuál empezar, no para firmar un presupuesto. El
				razonamiento completo, con un ejemplo y los casos en los que no
				compensa automatizar, está en la guía
				<a href="/guias/como-calcular-el-ahorro-de-una-automatizacion/"
					>cómo calcular el ahorro de una automatización</a
				>.
			</p>

			<h2>Cómo usarla bien</h2>
			<ol>
				<li>
					<strong>Mide, no estimes.</strong> Cuenta las repeticiones de una
					semana normal y cronometra varias. Las estimaciones de memoria casi
					siempre se quedan cortas.
				</li>
				<li>
					<strong>Hazlo con varias tareas.</strong> La cuenta es útil cuando
					se compara: repítela con las cinco o diez más repetitivas y ordena
					por horas recuperadas.
				</li>
				<li>
					<strong>Sé prudente con el porcentaje.</strong> Ninguna
					automatización elimina el cien por cien: quedan excepciones y
					revisión.
				</li>
			</ol>
			<p>
				¿No sabes qué tareas probar? Empieza por la lista de
				<a href="/guias/que-procesos-se-pueden-automatizar-en-una-empresa/"
					>procesos que se pueden automatizar en una empresa</a
				>.
			</p>

			<h2>Preguntas frecuentes</h2>
			{
				faq.map((f) => (
					<>
						<h3>{f.question}</h3>
						<p>{f.answer}</p>
					</>
				))
			}
		</article>
	</main>

	<FinalCTA />
</Layout>

<script>
	const form = document.getElementById("calc-form") as HTMLFormElement | null;
	const nf = new Intl.NumberFormat("es-ES", {
		maximumFractionDigits: 0,
		useGrouping: "always",
	});
	const set = (id: string, text: string) => {
		const el = document.getElementById(id);
		if (el) el.textContent = text;
	};

	function update() {
		if (!form) return;
		const v = (name: string) =>
			Math.max(0, Number((form.elements.namedItem(name) as HTMLInputElement).value) || 0);

		const share = v("share");
		const total = (v("times") * v("minutes") * v("weeks")) / 60;
		const hours = (total * share) / 100;
		const money = hours * v("rate");

		set("share-out", `${share} %`);
		set("r-total", nf.format(total));
		set("r-hours", nf.format(hours));
		set("r-money", nf.format(money));
		set("r-weeks", nf.format(hours / 40));

		// La vía: longitud = horas actuales; verde = recuperadas; marca = 40 h.
		const track = document.getElementById("r-track");
		if (track) {
			const weeks = total / 40;
			track.style.setProperty("--share", String(share / 100));
			track.style.setProperty(
				"--tick",
				weeks >= 2 && weeks <= 60 ? `${100 / weeks}%` : "100%",
			);
		}

		const invest = v("invest");
		const payback = document.getElementById("r-payback");
		if (!payback) return;
		payback.hidden = invest <= 0;
		if (invest > 0) {
			const net = money - v("upkeep");
			payback.textContent =
				net > 0
					? `La inversión se recupera en ${nf.format(Math.round((invest / net) * 12))} meses.`
					: "Con estos datos, la inversión no se recupera.";
		}
	}

	form?.addEventListener("input", update);
	update();
</script>

<style>
	.calc {
		max-width: 1200px;
		margin: 0 auto;
		padding: 168px var(--margin-edge) 120px;
	}

	.calc__crumbs {
		display: flex;
		flex-wrap: wrap;
		gap: 10px;
		line-height: 1.5;
		color: var(--on-surface-variant);
	}

	.calc__crumbs [aria-current] {
		color: var(--on-surface);
	}

	.calc__title {
		margin: var(--stack-md) 0 0;
		max-width: 18ch;
		font-size: clamp(40px, 6.2vw, 80px);
		font-weight: 800;
		letter-spacing: -0.04em;
		line-height: 1.02;
		text-wrap: balance;
	}

	.calc__lead {
		margin: var(--stack-md) 0 0;
		max-width: 52ch;
		font-size: clamp(18px, 1.7vw, 20px);
		line-height: 1.55;
		color: var(--on-surface-variant);
		text-wrap: pretty;
	}

	/* A la izquierda se completa una frase; a la derecha se lee otra. */
	.calc__tool {
		display: grid;
		grid-template-columns: minmax(0, 6fr) minmax(0, 5fr);
		column-gap: 96px;
		align-items: start;
		margin-top: var(--stack-lg);
		padding-top: var(--stack-lg);
		border-top: 2px solid var(--on-surface);
	}

	.calc__say {
		margin: 0;
		font-size: clamp(20px, 2vw, 26px);
		font-weight: 500;
		line-height: 1.8;
		letter-spacing: -0.02em;
	}

	.calc__say input,
	.calc__say output {
		font: inherit;
		font-weight: 800;
		font-variant-numeric: tabular-nums;
		letter-spacing: inherit;
		color: inherit;
	}

	.calc__say input {
		width: 2.8em;
		padding: 0 2px;
		text-align: center;
		background: none;
		border: 0;
		border-bottom: 2px solid var(--on-surface);
		border-radius: 0;
		appearance: textfield;
		-moz-appearance: textfield;
		transition:
			border-color 160ms ease-out,
			background 160ms ease-out;
	}

	.calc__say input::-webkit-outer-spin-button,
	.calc__say input::-webkit-inner-spin-button {
		appearance: none;
		margin: 0;
	}

	.calc__say input::placeholder {
		font-weight: 500;
		color: var(--outline);
	}

	.calc__say input:hover {
		background: var(--surface-container-low);
	}

	.calc__say input:focus-visible {
		outline: none;
		border-bottom-color: var(--tertiary);
		background: var(--surface-container-lowest);
	}

	.calc__say--optional {
		margin-top: var(--stack-md);
		padding-top: var(--stack-md);
		border-top: 1px solid var(--outline-variant);
		font-size: clamp(18px, 1.7vw, 22px);
		color: var(--on-surface-variant);
	}

	.calc__say--optional input {
		width: 3.8em;
		color: var(--on-surface);
		border-bottom-color: var(--outline);
	}

	.calc__hint {
		display: block;
		margin: 12px 0 0;
		max-width: 52ch;
		font-size: 14px;
		line-height: 1.5;
		color: var(--on-surface-variant);
	}

	.calc__share {
		display: block;
		margin-top: var(--stack-md);
	}

	/* El control es un tramo de vía con una estación que se desliza. */
	.calc__share input {
		display: block;
		width: 100%;
		height: 28px;
		margin: 12px 0 0;
		background: none;
		appearance: none;
		cursor: pointer;
	}

	.calc__share input::-webkit-slider-runnable-track {
		height: 2px;
		background: var(--outline-variant);
	}

	.calc__share input::-moz-range-track {
		height: 2px;
		background: var(--outline-variant);
	}

	.calc__share input::-webkit-slider-thumb {
		appearance: none;
		width: 18px;
		height: 18px;
		margin-top: -8px;
		border-radius: 50%;
		background: var(--tertiary);
		border: 2px solid var(--on-surface);
	}

	.calc__share input::-moz-range-thumb {
		width: 14px;
		height: 14px;
		border-radius: 50%;
		background: var(--tertiary);
		border: 2px solid var(--on-surface);
	}

	.calc__share input:focus-visible {
		outline: 2px solid var(--on-surface);
		outline-offset: 4px;
	}

	.calc__result {
		position: sticky;
		top: 128px;
	}

	.calc__out {
		margin: 0;
		font-size: clamp(30px, 3.6vw, 48px);
		font-weight: 800;
		letter-spacing: -0.035em;
		line-height: 1.28;
		text-wrap: balance;
	}

	.calc__out strong {
		font-weight: inherit;
		font-variant-numeric: tabular-nums;
		white-space: nowrap;
		text-decoration: underline;
		text-decoration-color: var(--tertiary);
		text-decoration-thickness: 6px;
		text-underline-offset: 6px;
		text-decoration-skip-ink: none;
	}

	.calc__track {
		--share: 0.75;
		--tick: 100%;
		position: relative;
		height: 14px;
		margin-top: var(--stack-lg);
		background:
			repeating-linear-gradient(
					90deg,
					var(--outline) 0 1px,
					transparent 1px var(--tick)
				)
				0 0 / 100% 100% no-repeat,
			linear-gradient(var(--outline-variant), var(--outline-variant)) 0 50% /
				100% 2px no-repeat;
	}

	.calc__track-fill {
		position: absolute;
		inset: 4px 0;
		background: var(--tertiary);
		transform-origin: left;
		scale: var(--share) 1;
		transition: scale 320ms cubic-bezier(0.16, 1, 0.3, 1);
	}

	.calc__legend {
		margin: 12px 0 0;
		font-size: 14px;
		line-height: 1.5;
		color: var(--on-surface-variant);
	}

	.calc__fact {
		margin: var(--stack-sm) 0 0;
		font-size: 18px;
		line-height: 1.5;
	}

	.calc__legend span,
	.calc__fact span {
		font-weight: 600;
		font-variant-numeric: tabular-nums;
		color: var(--on-surface);
	}

	.calc__btn {
		display: inline-block;
		margin-top: var(--stack-md);
		background: var(--tertiary);
		color: var(--on-tertiary);
		padding: 14px 24px;
		border-radius: var(--r);
		transition:
			transform 200ms ease,
			filter 200ms ease;
	}

	.calc__btn:hover {
		transform: scale(1.02);
		filter: brightness(0.97);
	}

	.calc__prose {
		max-width: 680px;
		margin-top: 120px;
	}

	.calc__prose :global(h2:first-child) {
		margin-top: 0;
	}

	@media (max-width: 1023px) {
		.calc__tool {
			grid-template-columns: minmax(0, 1fr);
			row-gap: var(--stack-lg);
		}

		.calc__result {
			position: static;
			padding-top: var(--stack-lg);
			border-top: 1px solid var(--outline-variant);
		}
	}

	@media (max-width: 768px) {
		.calc {
			padding: 128px var(--stack-md) var(--stack-lg);
		}

		.calc__tool {
			margin-top: 48px;
			padding-top: 48px;
		}

		.calc__prose {
			margin-top: 96px;
		}
	}

	@media (prefers-reduced-motion: reduce) {
		.calc__track-fill {
			transition: none;
		}
	}
</style>
