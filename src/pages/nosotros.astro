---
import { Image } from "astro:assets";
import Layout from "../layouts/Layout.astro";
import Header from "../components/Header.astro";
import { FOUNDERS, SITE } from "../data/site";
import { personNode } from "../lib/schema";
import marioPhoto from "../assets/team/mario-pantoja.jpg";
import davidPhoto from "../assets/team/david-gutierrez.jpg";

const photos = { mario: marioPhoto, david: davidPhoto } as const;
const crumbs = [{ name: "Nosotros", path: "/nosotros/" }];
---

<Layout
	title="Nosotros: quién está detrás de RAIL Consulting | Sevilla"
	description="RAIL Consulting es una consultora de ingeniería de Sevilla fundada por Mario Pantoja Castro y David Gutiérrez. IA, datos y software para ahorrar tiempo."
	breadcrumbs={crumbs}
	pageType="AboutPage"
	schema={FOUNDERS.map(personNode)}
	modified="2026-11-12"
>
	<Header />

	<main id="contenido" class="about">
		<header class="about__intro">
			<p class="label-caps about__eyebrow">Nosotros</p>
			<h1 class="about__title">Dos fundadores, una visión de ingeniería.</h1>
			<p class="about__lead">
				{SITE.name} es una consultora de ingeniería de Sevilla. Estudiamos
				cómo trabaja una empresa, detectamos dónde se pierde tiempo y lo
				recuperamos con inteligencia artificial, automatización y software a
				medida.
			</p>
		</header>

		<section class="about__team" aria-label="Equipo fundador">
			{
				FOUNDERS.map((f) => (
					<article class="founder" id={f.id}>
						<div class="founder__avatar">
							<Image
								src={photos[f.photo as keyof typeof photos]}
								alt={`${f.name}, ${f.jobTitle.toLowerCase()} de RAIL Consulting`}
								width={96}
								height={96}
								densities={[1, 2]}
								loading="eager"
							/>
						</div>
						<div class="founder__body">
							<h2 class="founder__name">{f.name}</h2>
							<p class="founder__role label-caps">{f.role}</p>
							<p class="founder__bio">{f.bio}</p>
							<a
								class="founder__link"
								href={f.linkedin}
								target="_blank"
								rel="noopener noreferrer me"
							>
								Ver perfil de LinkedIn →
							</a>
						</div>
					</article>
				))
			}
		</section>

		<section class="about__story" aria-labelledby="about-how">
			<h2 class="about__h2" id="about-how">Por qué existe RAIL</h2>
			<p>
				En casi todas las empresas hay personas muy válidas dedicando horas a
				copiar datos de un programa a otro, a rehacer el mismo documento o a
				esperar una respuesta. No es falta de esfuerzo: es que nadie se ha
				parado a mirar cómo fluye el trabajo.
			</p>
			<p>
				RAIL nace para hacer exactamente eso. Uno de los fundadores viene de
				las matemáticas, la estadística y la inteligencia artificial; el otro,
				del desarrollo de software y el análisis de negocio. Juntos cubrimos el
				recorrido completo: entender un proceso, medirlo y construir lo que lo
				mejora.
			</p>

			<h2 class="about__h2">Cómo trabajamos</h2>
			<ol class="about__steps">
				<li>
					<strong>Estudio.</strong> Nos sentamos con el equipo y vemos cómo se
					trabaja de verdad. Lo explicamos en el
					<a href="/estudio-de-procesos/">estudio de procesos</a>.
				</li>
				<li>
					<strong>Diagnóstico.</strong> Ordenamos las oportunidades por el
					tiempo que devuelven.
				</li>
				<li>
					<strong>Solución.</strong> Construimos solo lo que compensa: un
					<a href="/agentes-de-ia/">agente de IA</a>, una
					<a href="/soluciones/automatizacion-de-procesos/">automatización</a>
					o <a href="/soluciones/">software a medida</a>.
				</li>
			</ol>

			<h2 class="about__h2">Dónde estamos</h2>
			<p>
				Tenemos nuestra base en <a href="/consultoria-ia-sevilla/">Sevilla</a>
				y trabajamos con empresas de toda España. Puedes escribirnos a
				<a href={`mailto:${SITE.email}`}>{SITE.email}</a> o desde la
				<a href="/contacto/">página de contacto</a>.
			</p>
		</section>

		<a href="/" class="about__home">← Volver al inicio</a>
	</main>
</Layout>

<style>
	.about {
		max-width: var(--container-max);
		margin: 0 auto;
		padding: 22vh var(--margin-edge) var(--stack-lg);
	}

	.about__intro {
		max-width: 760px;
		margin: 0 auto var(--stack-lg);
		text-align: center;
	}

	.about__eyebrow {
		color: var(--on-surface-variant);
		margin: 0 0 var(--stack-sm);
	}

	.about__title {
		margin: 0 0 var(--stack-md);
		font-size: clamp(40px, 6vw, 72px);
		font-weight: 800;
		letter-spacing: -0.04em;
		line-height: 1.04;
	}

	.about__lead {
		margin: 0;
		font-size: clamp(17px, 2vw, 20px);
		line-height: 1.6;
		color: var(--on-surface-variant);
	}

	.about__team {
		display: grid;
		grid-template-columns: repeat(2, 1fr);
		gap: var(--stack-md);
	}

	.founder {
		display: flex;
		flex-direction: column;
		gap: var(--stack-md);
		padding: var(--stack-md);
		background: var(--surface-container-lowest);
		border: 1px solid var(--outline-variant);
		border-radius: var(--r-xl);
	}

	.founder__avatar {
		display: grid;
		place-items: center;
		width: 96px;
		height: 96px;
		border-radius: 50%;
		background: var(--surface-container-high);
		overflow: hidden;
	}

	.founder__avatar img {
		width: 100%;
		height: 100%;
		object-fit: cover;
	}

	.founder__initials {
		font-size: 32px;
		font-weight: 800;
		letter-spacing: -0.02em;
		color: var(--on-surface-variant);
	}

	.founder__name {
		margin: 0 0 6px;
		font-size: 24px;
		font-weight: 700;
		letter-spacing: -0.02em;
	}

	.founder__role {
		margin: 0 0 var(--stack-sm);
		color: #3d6b2a;
	}

	.founder__bio {
		margin: 0 0 var(--stack-sm);
		font-size: 15px;
		line-height: 1.6;
		color: var(--on-surface-variant);
	}

	.founder__link {
		font-weight: 600;
		font-size: 14px;
		color: var(--on-surface);
		transition: color 200ms ease;
	}

	.founder__link:hover {
		color: var(--tertiary);
	}

	.founder {
		scroll-margin-top: 110px;
	}

	.about__story {
		max-width: 760px;
		margin: var(--stack-lg) auto 0;
		font-size: 17px;
		line-height: 1.75;
		color: var(--on-surface-variant);
	}

	.about__story p {
		margin: 0 0 var(--stack-sm);
	}

	.about__h2 {
		margin: var(--stack-lg) 0 var(--stack-sm);
		font-size: clamp(24px, 3.2vw, 32px);
		font-weight: 700;
		letter-spacing: -0.02em;
		line-height: 1.15;
		color: var(--on-surface);
	}

	.about__h2:first-child {
		margin-top: 0;
	}

	.about__steps {
		margin: 0;
		padding-left: 22px;
	}

	.about__steps li {
		margin-bottom: 10px;
	}

	.about__story strong {
		color: var(--on-surface);
		font-weight: 600;
	}

	.about__story a {
		color: var(--on-surface);
		text-decoration: underline;
		text-decoration-color: var(--tertiary);
		text-decoration-thickness: 2px;
		text-underline-offset: 3px;
	}

	.about__home {
		display: inline-block;
		margin-top: var(--stack-lg);
		font-weight: 600;
		font-size: 14px;
		color: var(--on-surface-variant);
		transition: color 200ms ease;
	}

	.about__home:hover {
		color: var(--on-surface);
	}

	@media (max-width: 768px) {
		.about {
			padding: 18vh var(--stack-md) var(--stack-lg);
		}

		.about__team {
			grid-template-columns: 1fr;
		}
	}
</style>
