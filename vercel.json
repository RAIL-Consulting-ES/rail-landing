{
	"$schema": "https://openapi.vercel.sh/vercel.json",
	"framework": "astro",
	"buildCommand": "astro build",
	"outputDirectory": "dist",
	"trailingSlash": true,
	"headers": [
		{
			"source": "/(.*)",
			"headers": [
				{
					"key": "X-Content-Type-Options",
					"value": "nosniff"
				},
				{
					"key": "X-Frame-Options",
					"value": "SAMEORIGIN"
				},
				{
					"key": "Referrer-Policy",
					"value": "strict-origin-when-cross-origin"
				},
				{
					"key": "Strict-Transport-Security",
					"value": "max-age=31536000; includeSubDomains"
				},
				{
					"key": "Permissions-Policy",
					"value": "geolocation=(), microphone=(), camera=()"
				}
			]
		},
		{
			"source": "/(.*)\\.md",
			"headers": [
				{
					"key": "X-Robots-Tag",
					"value": "noindex, follow"
				},
				{
					"key": "Content-Type",
					"value": "text/markdown; charset=utf-8"
				}
			]
		},
		{
			"source": "/(llms\\.txt|llms-full\\.txt)",
			"headers": [
				{
					"key": "Content-Type",
					"value": "text/markdown; charset=utf-8"
				},
				{
					"key": "X-Robots-Tag",
					"value": "noindex, follow"
				}
			]
		},
		{
			"source": "/_astro/(.*)",
			"headers": [
				{
					"key": "Cache-Control",
					"value": "public, max-age=31536000, immutable"
				}
			]
		}
	],
	"redirects": [
		{
			"source": "/solutions",
			"destination": "/soluciones/",
			"permanent": true
		},
		{
			"source": "/solutions/",
			"destination": "/soluciones/",
			"permanent": true
		},
		{
			"source": "/about",
			"destination": "/nosotros/",
			"permanent": true
		},
		{
			"source": "/about/",
			"destination": "/nosotros/",
			"permanent": true
		},
		{
			"source": "/contact",
			"destination": "/contacto/",
			"permanent": true
		},
		{
			"source": "/contact/",
			"destination": "/contacto/",
			"permanent": true
		},
		{
			"source": "/solutions/erp",
			"destination": "/soluciones/erp-a-medida/",
			"permanent": true
		},
		{
			"source": "/solutions/erp/",
			"destination": "/soluciones/erp-a-medida/",
			"permanent": true
		},
		{
			"source": "/solutions/crm",
			"destination": "/soluciones/crm-a-medida/",
			"permanent": true
		},
		{
			"source": "/solutions/crm/",
			"destination": "/soluciones/crm-a-medida/",
			"permanent": true
		},
		{
			"source": "/solutions/automation",
			"destination": "/soluciones/automatizacion-de-procesos/",
